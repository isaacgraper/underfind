{
  "name": "Underfind 2.0 - Descoberta Diária de Shorts Virais & Modelagem de Roteiros",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger-1",
      "name": "Disparo Diário (08:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "url": "http://underfind:8000/api/shorts/outliers",
        "options": {},
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "finanças"
            },
            {
              "name": "max_subscribers",
              "value": "50000"
            },
            {
              "name": "min_views",
              "value": "10000"
            },
            {
              "name": "min_viral_ratio",
              "value": "3.0"
            },
            {
              "name": "max_results",
              "value": "5"
            },
            {
              "name": "region_code",
              "value": "BR"
            }
          ]
        }
      },
      "id": "http-search-outliers",
      "name": "Buscar Shorts Outliers no Underfind",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-batches",
      "name": "Iterar Vídeos",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [660, 300]
    },
    {
      "parameters": {
        "url": "=http://underfind:8000/api/blueprint/{{ $json.video_id }}",
        "options": {},
        "queryParameters": {
          "parameters": [
            {
              "name": "niche",
              "value": "investimentos para iniciantes"
            }
          ]
        }
      },
      "id": "http-get-blueprint",
      "name": "Extrair Hook & Blueprint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [880, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Você é um roteirista sênior de YouTube Shorts virais.\n\nAnalise o blueprint deste vídeo outlier:\n- Título Original: {{ $json.title }}\n- Viral Ratio: {{ $json.viral_ratio }}x (Views: {{ $json.views }} | Inscritos: {{ $json.subscribers }})\n- Gancho Inicial (Hook): \"{{ $json.hook_text }}\"\n- Transcrição: {{ $json.full_transcript }}\n\nCrie 2 roteiros originais e prontos para gravar para o meu nicho (investimentos para iniciantes), mantendo a mesma técnica de gancho inicial dos primeiros 3 segundos."
      },
      "id": "llm-modeling",
      "name": "Modelar Roteiro com IA",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "chatId": "SEU_CHAT_ID",
        "text": "=🚀 *Novo Short Outlier Modelado pelo Underfind!*\n\n*Vídeo Original:* {{ $('http-get-blueprint').item.json.title }}\n*Viral Ratio:* {{ $('http-get-blueprint').item.json.viral_ratio }}x 🔥\n*Hook Original:* \"{{ $('http-get-blueprint').item.json.hook_text }}\"\n\n*Novos Roteiros Sugeridos:*\n{{ $json.output }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-notification",
      "name": "Enviar para Telegram / Notion",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1320, 300]
    }
  ],
  "connections": {
    "Disparo Diário (08:00)": {
      "main": [
        [
          {
            "node": "Buscar Shorts Outliers no Underfind",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar Shorts Outliers no Underfind": {
      "main": [
        [
          {
            "node": "Iterar Vídeos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Iterar Vídeos": {
      "main": [
        [
          {
            "node": "Extrair Hook & Blueprint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extrair Hook & Blueprint": {
      "main": [
        [
          {
            "node": "Modelar Roteiro com IA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Modelar Roteiro com IA": {
      "main": [
        [
          {
            "node": "Enviar para Telegram / Notion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
}
