# ==============================================================================
# Underfind 2.0 - Configurações de Ambiente
# ==============================================================================

# [OBRIGATÓRIO] Chave da API do YouTube (YouTube Data API v3)
# Obtenha gratuitamente em: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# [OPCIONAL] Orçamento diário de unidades da YouTube Data API (padrão do Google: 10000; reseta à meia-noite, horário do Pacífico)
# search.list custa 100 unidades; videos.list e channels.list custam 1.
YOUTUBE_DAILY_QUOTA=10000

# [OPCIONAL] Configurações do Servidor Web / API
PORT=8000
HOST=0.0.0.0
DEBUG=true

# [OPCIONAL] Configurações Legadas do Supabase (Apenas se quiser reativar Auth remota)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=eyJh...

# [OPCIONAL] Pipeline de localização
# Worker embutido no servidor (ou rode separado: python app.py worker)
PIPELINE_WORKER_ENABLED=false
WORKER_POLL_INTERVAL_SECONDS=30
WORKER_MAX_PARALLEL_JOBS=2

# Download (yt-dlp): Instagram/TikTok costumam exigir login; exporte cookies.txt de um navegador logado
# YTDLP_COOKIES_FILE=/caminho/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_PROXY=http://user:pass@host:port

# Transcrição (faster-whisper): tiny/base/small/medium/large-v3; int8 para CPU, float16 para GPU
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Tradução: modelos gratuitos com fallback (config/llm.yaml)
# NVIDIA (principal, grátis, 40 req/min): https://build.nvidia.com -> API key
NVIDIA_API_KEY=
# Atria-Dawn-Preview (Shanghai AI Lab; grátis até 100M tokens): https://api.atria-asi.ai/
ATRIA_API_KEY=
# OpenRouter modelos :free (~50 req/dia sem créditos): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_TITLE=underfind
# Troca o modelo principal de um papel: UNDERFIND_<PAPEL>_MODEL (ex.: UNDERFIND_TRANSLATOR_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b)
# Claude (pago) é opcional: poetry install -E claude, ANTHROPIC_API_KEY e o papel translator_claude em config/llm.yaml
# GLOSSARY_FILE=/caminho/glossario.json   # lista JSON de termos extras que não devem ser traduzidos

# Dublagem (edge-tts, gratuito; requer acesso a speech.platform.bing.com)
DUB_BACKGROUND_VOLUME=0.12
# TTS_PROXY=http://user:pass@host:port
