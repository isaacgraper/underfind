# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows specific scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.sqlite3 binary
*.db binary
*.woff binary
*.woff2 binary
*.ttf binary
